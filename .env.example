# ---- Database (MongoDB Atlas) ----
# Keep <password> in the URI; the app swaps in MONGODB_PASSWORD (URL-encoded) at runtime.
MONGODB_URI=mongodb+srv://dev_db_user:<password>@clientmanager.de7bfbd.mongodb.net/?retryWrites=true&w=majority&appName=ClientManager
MONGODB_PASSWORD=
MONGODB_DB=tenx_portal

# ---- App ----
APP_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=
SUPER_ADMIN_EMAIL=dev@tenxcreative.com

# ---- Email ----
# smtp = Gmail SMTP (smtp.gmail.com:465 + Google App Password)
# console = development only: writes emails to the email log and the terminal instead of sending
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# 16-character Google App Password for SMTP_USER (needs 2-Step Verification on that mailbox)
SMTP_PASS=
EMAIL_FROM="10X Creative <billing@tenxcreative.com>"

# ---- Cloudflare Turnstile (optional in development) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# R2 (binding FILES) and Browser Run (binding BROWSER) are configured in wrangler.jsonc.
